# DataMind configuration settings
# No API key is required for core DataMind functionality

# Storage directory for SQLite database, datasets, splits, experiments, and exports
DATAMIND_STORAGE_DIR=./storage

# Log directory (default: ./logs)
DATAMIND_LOGS_DIR=./logs

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
DATAMIND_LOG_LEVEL=INFO

# Maximum CSV upload size in MiB (default: 10)
DATAMIND_MAX_UPLOAD_MIB=10

# Maximum number of rows allowed in uploaded datasets (default: 20000)
DATAMIND_MAX_ROWS=20000

# Maximum number of columns allowed in uploaded datasets (default: 100)
DATAMIND_MAX_COLUMNS=100

# Default random seed for reproducible experiments (default: 42)
DATAMIND_DEFAULT_SEED=42

# Thread limits for numerical libraries (set to 1 for deterministic behavior)
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
