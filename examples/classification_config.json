{
  "schema_version": 1,
  "project_id": "REPLACE_WITH_CREATED_PROJECT_ID",
  "dataset_id": "REPLACE_WITH_IMPORTED_IRIS_DATASET_ID",
  "task": "classification",
  "target": "species",
  "feature_roles": {
    "numeric": ["sepal_length", "sepal_width", "petal_length", "petal_width"],
    "categorical": []
  },
  "row_policy": {
    "drop_missing_target": false,
    "drop_exact_duplicates": true
  },
  "preprocessing": {
    "numeric_imputer": "median",
    "scaler": "standard",
    "categorical_imputer": "constant",
    "categorical_encoder": "one_hot",
    "handle_unknown": "ignore"
  },
  "split": {
    "test_fraction": 0.2,
    "cv_folds": 5,
    "seed": 42
  },
  "models": [
    {"algorithm_id": "logistic_regression", "parameters": {"C": 1.0, "max_iter": 1000}},
    {"algorithm_id": "decision_tree_classifier", "parameters": {"max_depth": 5}},
    {"algorithm_id": "random_forest_classifier", "parameters": {"n_estimators": 100, "max_depth": 10}}
  ],
  "primary_metric": "f1_macro",
  "random_seed": 42
}
